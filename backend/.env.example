# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8000

# Comma-separated list of browser origins allowed to call this API.
# Portal runs on 5173, admin panel on 5174 by default.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------------------------------------------------------------------------
# Database (LOCAL MongoDB)
# ---------------------------------------------------------------------------
# Local install:   mongodb://127.0.0.1:27017/gdg_recruitment
# Docker Compose:  mongodb://mongo:27017/gdg_recruitment
MONGO_URI=mongodb://127.0.0.1:27017/gdg_recruitment

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Admin panel login. Prefer ADMIN_PASSWORD_HASH in production.
# Generate a hash with:  npm run -s hash-admin-password
ADMIN_PASSWORD=change-me-in-production
# ADMIN_PASSWORD_HASH=$2b$12$....

# ---------------------------------------------------------------------------
# Firebase Admin (verifies the Google ID token sent by the portal)
# ---------------------------------------------------------------------------
# Either paste the whole service-account JSON on one line...
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account", ...}
# ...or supply the individual fields:
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# Set to true to bypass Firebase token verification during local development.
# The portal must then send an unverified token; NEVER enable in production.
AUTH_ALLOW_INSECURE_DEV_LOGIN=false

# ---------------------------------------------------------------------------
# Proctoring
# ---------------------------------------------------------------------------
# Number of tab-switch / focus-loss violations before the attempt is force-submitted.
MAX_VIOLATIONS=4
