# Base URL of the API server (no trailing /api - the client appends it).
VITE_API_URL=http://localhost:8000

# Firebase web config - from Firebase console > Project settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Proctoring depth.
#   mock   (default) camera and mic are switched on, nothing is analysed
#   detect            additionally runs on-device detection of phones and extra
#                     people, flagging them for a human to review
VITE_PROCTOR_MODE=mock
