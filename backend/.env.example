# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8000

# Comma-separated list of browser origins allowed to call this API.
# Portal runs on 5173, admin panel on 5174 by default.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Hostname suffixes allowed on top of CORS_ORIGINS, for tunnels whose hostname
# changes on every restart. Leave empty in production.
CORS_ORIGIN_SUFFIXES=

# ---------------------------------------------------------------------------
# Database (LOCAL MongoDB)
# ---------------------------------------------------------------------------
# Local install:   mongodb://127.0.0.1:27017/gdg_recruitment
# Docker Compose:  mongodb://mongo:27017/gdg_recruitment
MONGO_URI=mongodb://127.0.0.1:27017/gdg_recruitment

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Admin panel login. Prefer ADMIN_PASSWORD_HASH in production.
# Generate a hash with:  npm run -s hash-admin-password
ADMIN_PASSWORD=change-me-in-production
# ADMIN_PASSWORD_HASH=$2b$12$....

# ---------------------------------------------------------------------------
# Firebase Admin (verifies the Google ID token sent by the portal)
# ---------------------------------------------------------------------------
# Either paste the whole service-account JSON on one line...
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account", ...}
# ...or supply the individual fields:
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# Set to true to bypass Firebase token verification during local development.
# The portal must then send an unverified token; NEVER enable in production.
AUTH_ALLOW_INSECURE_DEV_LOGIN=false

# ---------------------------------------------------------------------------
# Proctoring
# ---------------------------------------------------------------------------
# Return stack traces in error responses. Development only; forced off when
# NODE_ENV=production regardless of this value.
EXPOSE_STACK_TRACES=false

# Number of tab-switch / focus-loss violations before the attempt is force-submitted.
MAX_VIOLATIONS=4

# Email domains eligible to sit the test, comma separated. Subdomains count,
# so thapar.edu also admits student.thapar.edu. Anyone with such an address can
# sign in without being whitelisted first.
#
# The allowed_users collection still applies on top, as an exceptions list for
# addresses outside these domains. Leave this empty for whitelist-only access.
ALLOWED_EMAIL_DOMAINS=thapar.edu
