{
  "name": "@gdg/recruitment-backend",
  "version": "1.0.0",
  "description": "GDG Recruitment Portal - API server (Express + Mongoose)",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "dev:mem": "node scripts/dev_memory_server.js",
    "seed": "node scripts/seed.js",
    "seed:quiz": "node scripts/add_quiz.js",
    "seed:allowed": "node scripts/add_allowed_emails.js",
    "lint": "echo \"no linter configured for backend\"",
    "hash-admin-password": "node scripts/hash_admin_password.js",
