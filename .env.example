# Credentials for docker-compose (the mongo container).
# Copy this file to .env at the repo root and set a strong password.
# This .env is read ONLY by docker compose for ${...} substitution - it is
# separate from backend/.env, apps/portal/.env, and apps/admin/.env.

MONGO_ROOT_USER=gdgadmin
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MONGO_ROOT_PASSWORD=
